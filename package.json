{
  "name": "gspb-cs",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @gspb-cs/database db:generate",
    "db:push": "pnpm --filter @gspb-cs/database db:push",
    "db:seed": "dotenv -e .env -- prisma db seed --schema prisma/schema.prisma",
    "postinstall": "pnpm db:generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.5.3",
    "prisma": "6.19.3",
    "tsx": "^4.22.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
