# Clerk (from Clerk Dashboard or `pnpm dlx clerk@latest init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase Postgres (Prisma). Use the "Transaction" pooler URI for serverless / Cloudflare.
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=

# Optional: Supabase project URL + secret key for future storage/realtime (not used for auth)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (org: gspb, project slug: gspb-web)
# Client Settings → DSN in Sentry project settings
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map uploads at build (also written to apps/web/.env.sentry-build-plugin by the wizard)
SENTRY_AUTH_TOKEN=
# Set to 1 to allow GET /api/sentry-verify in production
# SENTRY_ENABLE_VERIFY=0

# Signup policy: open | invite_only | admin_only
PLATFORM_SIGNUP_POLICY=invite_only
