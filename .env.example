# Clerk (from Clerk Dashboard or `pnpm dlx clerk@latest init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase Postgres (Prisma). Use the "Transaction" pooler URI for serverless / Cloudflare.
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=

# Optional: Supabase project URL + secret key for future storage/realtime (not used for auth)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signup policy: open | invite_only | admin_only
PLATFORM_SIGNUP_POLICY=invite_only
