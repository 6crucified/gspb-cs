{
  "name": "@gspb-cs/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -e .env.local --override -- next dev --port 3000",
    "build": "node ./scripts/with-env.mjs pnpm --filter @gspb-cs/database db:generate && node ./scripts/with-env.mjs pnpm exec next build",
    "build:cf": "node ./scripts/with-env.mjs pnpm exec opennextjs-cloudflare build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cf:deploy": "node ./scripts/with-env.mjs pnpm exec opennextjs-cloudflare build && node ./scripts/with-env.mjs pnpm exec wrangler deploy",
    "cf:dev": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.5",
    "@clerk/localizations": "^4.24.6",
    "@clerk/nextjs": "^6.39.5",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@gspb-cs/auth": "workspace:*",
    "@gspb-cs/database": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "agents": "^0.33.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/types": "^4.86.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "wrangler": "^4.155.0"
  }
}
